{
    "type": "project",
    "license": "proprietary",
    "require": {
        "behat/behat": "*",
        "ext-pdo": "*",
        "symfony/console": "^7.4"
    }
  ,
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^11.0"
  },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "ocramius/package-versions": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
